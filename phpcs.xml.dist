<?xml version="1.0"?>
<ruleset name="Knock First – Password Protect Your Site">
	<description>WordPress coding standards for Knock First – Password Protect Your Site.</description>

	<file>knock-first-password-protection.php</file>
	<file>includes</file>
	<file>templates</file>
	<file>uninstall.php</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="PHPCompatibility">
		<include-pattern>*\.php$</include-pattern>
	</rule>

	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="knock-first-password-protection"/>
			</property>
		</properties>
	</rule>
</ruleset>
